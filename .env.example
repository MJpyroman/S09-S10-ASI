# Image applicative utilisee par docker-compose.
# En local on laisse la valeur par defaut (compose build ./starter-app).
# En CI, le job deploy pointe sur l'image publiee sur ghcr.io.
APP_IMAGE=s09-devops-app:local

# SHA du commit deploye, expose par /status et verifie par deploy.sh
# avant toute bascule de trafic (etape 8).
APP_COMMIT_SHA=dev

# Hote Redis. Surchargeable pour simuler une dependance cassee et verifier
# que /health passe en 503 et que deploy.sh refuse de basculer le trafic :
#   REDIS_HOST=redis-inexistant ./deploy/deploy.sh
REDIS_HOST=redis
